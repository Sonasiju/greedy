
#include <iostream>
#include<algorithm>
#include<climits>
using namespace std;
int main()
{
   int n;
    cout<<"Enter size";
   cin>>n;
   int arr[n];
   cout<<"Enter array elements";
   for(int i=0;i<n;i++)
    {
        cin>>arr[i];
    }
    int k;
    cout<<"enter sum";
    cin>>k;
    int left=0;
    int right=0;
    int sum=0;
    int length=0;
    int max_length=0;
    while(right<n)
    {
        sum+=arr[right];
        while(sum>k && left<=right)
        {
            sum-=arr[left];
            left++;
        }
            length=right-left+1;
        if(sum==k)
        {
            max_length=max(max_length,length);
        
        }
        right++;
        
    }
    cout<<max_length;
    return 0;
}
