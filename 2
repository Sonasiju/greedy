#include <bits/stdc++.h>
using namespace std;

long long sumOfPrimes(int N)
{
    int sum=0;
    // WRITE YOUR LOGIC HERE
    for(int i=2;i<=N;i++)
    {
        int count=0;
        int num=i;
        for(int j=1;j<=num;j++)
        {
            
            if(num % j ==0)
            {
                count++;
            }
            if(count>2)
        {
            break;
        }
        
        }
        if(count==2) sum+=num;
    
    }
return sum;

}

int main()
{
    int N;
    cin >> N;

    cout << sumOfPrimes(N);

    return 0;
}
