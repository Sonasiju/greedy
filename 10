#include <iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
  vector<pair<int,int>>date;
  int n;
  cout<<"enter number";
  cin>>n;
  cout<<"enter dates";
  for(int i=0;i<n;i++)
  {
      string s;
      cin>>s;
      int month=stoi(s.substr(0,2));
      int year=stoi(s.substr(3,4));
      date.push_back({year,month});
  }
  sort(date.begin(),date.end());
  for(int i=0;i<n;i++)
  {
      if(date[i].second<10)
      {
          cout<<0;
      }
      cout<<date[i].second<<"-"<<date[i].first<<endl;
  }
  

    return 0;
}
