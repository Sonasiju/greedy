
#include <iostream>
#include<vector>
#include<algorithm>
using namespace std;
vector<int>nums;
int result(int x,int requiredParity)
{
    int count=0;
    while(x % 2 != requiredParity)
    {
        x=x/2;
        count++;
    }
    return count;
}

int main()
{ cout<<"Enter array size";
  int n;
  cin>>n;
  cout<<"Enter array elements";
  for(int i=0;i<n;i++)
  {
     int x;
     cin>>x;
     nums.push_back(x);
  }
  int costOdd=0;
  int costEven=0;
  
  for(int i=0;i<n;i++)
{
    int requiredParity1=i%2;
    costEven+=result(nums[i],requiredParity1);
    
    int requiredParity2=1-(i%2);
    costOdd+=result(nums[i],requiredParity2);
}
cout<<min(costOdd,costEven);
return 0;
}
