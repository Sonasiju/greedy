
#include <iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
    vector<int>binary;
   int num;
   cout<<"Enter number";
   cin>>num;
   bool negative=false;
   if(num<0)
   {
       negative=true;
       num=-num;
   }
   if(num==0) {
       binary.push_back(0);
   }
   while(num>0)
   {
       binary.push_back(num % 2);
       num=num/2;
   }
   reverse(binary.begin(),binary.end());
   if(negative)
   {
       cout<<"-";
   }
   for (int x:binary)
   {
       cout<<x;
   }

    return 0;
}
